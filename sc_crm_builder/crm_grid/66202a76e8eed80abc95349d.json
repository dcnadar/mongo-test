      "$key": "oldb74zgs58",
      "key": "status",
      "name": "Status",
      "type": "text",
      "sort": false,
      "valueCondition": "function getStatusColor(status) {     switch (status) {         case \"LIVE\":             return \"#28a745\";         case \"UNDER_DEVELOPMENT\":             return \"#ffc107\";         case \"PENDING_APPROVAL\":             return \"#dc3545\";         case \"SETUP_IN_PROGRESS\":             return \"#17a2b8\";         case \"UNDER_REVIEW_AND_ACCEPTANCE\":             return \"#6f42c1\";         case \"UNDER_MAINTENANCE\":             return \"#fd7e14\";         case \"SUBSCRIPTION_EXPIRED\":             return \"#e83e8c\";         case \"INACTIVE\":             return \"#6c757d\";         case \"DELETED\":             return \"#000000\";         default:             return \"#333\";     } }  function toTitleCaseWithSpaces(str) {     return str         .toLowerCase()         .split('_')         .map(word => word.charAt(0).toUpperCase() + word.slice(1))         .join(' '); }  const statusColor = getStatusColor(this.status); const statusText = toTitleCaseWithSpaces(this.status || \"N/A\");  let htmlString = `   <div style=\"font-size:12px; color:#333; line-height:1.6;\">       <span style=\"background-color:${statusColor}; color:#fff; font-weight:bold; padding:2px 6px; border-radius:4px;\">${statusText}       </span>   </div> `;  return htmlString;"
    },
