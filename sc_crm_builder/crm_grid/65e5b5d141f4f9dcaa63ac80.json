          "$key": "7rx965wohes",
          "id": "isUserAccount",
          "title": "Enable User Login",
          "type": "bool",
          "span": {
            "$numberInt": "4"
          },
          "onChangeCondition": [
            {
              "$key": "etzek82vk85",
              "key": "properties",
              "meta": {
                "type": "function"
              },
              "value": "function convert(properties) {   if (!properties) {     properties = [];   }   const requiredKeys = [     \"firstName\",     \"middleName\",     \"lastName\",     \"email\",     \"userId\",   ];   let existing = properties     .filter((p) => requiredKeys.includes(p.key))     .map((p) => p.key);   let notExisting = requiredKeys.filter((k) => !existing.includes(k));   notExisting.forEach((k) => {     if (k === \"firstName\") {       properties.push({         $key: Math.random().toString(36).substring(2),         key: k,         dataType: \"STRING\",         name: \"First name\",       });     }     if (k === \"lastName\") {       properties.push({         $key: Math.random().toString(36).substring(2),         key: k,         dataType: \"STRING\",         name: \"Last name\",       });     }     if (k === \"middleName\") {       properties.push({         $key: Math.random().toString(36).substring(2),         key: k,         dataType: \"STRING\",         name: \"Middle name\",       });     }     if (k === \"email\") {       properties.push({         $key: Math.random().toString(36).substring(2),         key: k,         dataType: \"STRING\",         name: \"Email\",       });     }     if (k === \"userId\") {       properties.push({         $key: Math.random().toString(36).substring(2),         key: k,         dataType: \"REFERENCE\",         name: \"User ID\",         modelId: \"User\",       });     }   });   return properties; } return this.isUserAccount ? convert(this.properties) : this.properties;"
            }
          ],
          "updateType": "disabled"
        }
      ]
