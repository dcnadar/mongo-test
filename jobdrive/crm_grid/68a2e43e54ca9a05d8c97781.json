      "sort": true,
      "type": "text",
      "valueCondition": "const data = this || {};  const htmlString = `   <div style=\"width:100%;max-width:600px;margin:0 auto;padding:15px;font-size:14px;color:#333;line-height:1.6;\">     ${data.interviewerName ? `<div style=\"margin-bottom:8px;\"><strong>Interviewer Name:</strong> ${data.interviewerName}</div>` : \"\"}     ${data.interviewerEmail ? `<div style=\"margin-bottom:8px;\"><strong>Interviewer Email:</strong> ${data.interviewerEmail}</div>` : \"\"}   </div> `;  return htmlString;"
    },
