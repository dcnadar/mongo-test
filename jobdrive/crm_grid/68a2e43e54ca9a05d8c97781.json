    {
      "$key": "xkrmhoz16f8",
      "key": "interviewDateAndTime",
      "name": "Interview Date And Time",
      "sort": true,
      "type": "text",
      "valueCondition": "const data = this || {};  let formattedDateTime = \"\";  if (data.interviewDateAndTime) {    const date = new Date(data.interviewDateAndTime);    const day = String(date.getDate()).padStart(2, \"0\");    const month = date.toLocaleString(\"en-US\", { month: \"short\" });    const year = date.getFullYear();    let hours = date.getHours();    const minutes = String(date.getMinutes()).padStart(2, \"0\");    const ampm = hours >= 12 ? \"pm\" : \"am\";    hours = hours % 12 || 12;    formattedDateTime = `${day} ${month} ${year}, ${hours}:${minutes} ${ampm}`;  }  const htmlString = `<div style=\"width:100%;max-width:600px;margin:0 auto;padding:15px;font-size:14px;color:#333;line-height:1.6;\">${formattedDateTime ? `<div style=\"margin-bottom:8px;\">${formattedDateTime}</div>` : \"\"}</div>`;  return htmlString;"
    },
    {
      "$key": "kn295gst1u",
      "key": "interviewStatus",
      "name": "Interview Status",
      "type": "text",
      "sort": true,
      "valueCondition": "const data=this||{},tz=\"Asia/Kolkata\",fmt=iso=>iso?new Date(iso).toLocaleString(\"en-IN\",{timeZone:tz,year:\"numeric\",month:\"short\",day:\"2-digit\",hour:\"2-digit\",minute:\"2-digit\"}):\"\",statusColor=data.interviewStatus===\"ONGOING\"?\"#007bff\":data.interviewStatus===\"COMPLETED\"?\"#28a745\":data.interviewStatus===\"CANCELLED\"?\"#dc3545\":data.interviewStatus===\"SCHEDULED\"?\"#ffc107\":\"#333\",rows=[data.interviewStatus&&`<div style=\"margin-bottom:8px;\"><strong>Status:</strong> <span style=\"color:${statusColor};font-weight:bold;\">${data.interviewStatus}</span></div>`,...(data.interviewStatus===\"ONGOING\"?[data.ongoingDate&&`<div style=\"margin-bottom:8px;\"><strong>Start time:</strong> ${fmt(data.ongoingDate)}</div>`,data.location&&`<div style=\"margin-bottom:8px;\"><strong>Location:</strong> ${data.location}</div>`]:data.interviewStatus===\"COMPLETED\"?[data.ongoingDate&&`<div style=\"margin-bottom:8px;\"><strong>Start time:</strong> ${fmt(data.ongoingDate)}</div>`,(data.completedDate||data.completedTime||data.interviewDateAndTime)&&`<div style=\"margin-bottom:8px;\"><strong>Completed time:</strong> ${fmt(data.completedDate||data.completedTime||data.interviewDateAndTime)}</div>`,data.location&&`<div style=\"margin-bottom:8px;\"><strong>Location:</strong> ${data.location}</div>`,data.feedback&&`<div style=\"margin-bottom:8px;\"><strong>Feedback:</strong> ${data.feedback}</div>`,(data.score||data.score===0)&&`<div style=\"margin-bottom:8px;\"><strong>Score:</strong> ${data.score}</div>`]:data.interviewStatus===\"CANCELLED\"?[data.cancelledDate&&`<div style=\"margin-bottom:8px;\"><strong>Cancelled time:</strong> ${fmt(data.cancelledDate)}</div>`,data.comment&&`<div style=\"margin-bottom:8px;\"><strong>Reason:</strong> ${data.comment}</div>`]:[])],htmlString=rows.length?`<div style=\"width:100%;max-width:600px;margin:0 auto;padding:15px;font-size:14px;color:#333;line-height:1.6;\">${rows.filter(Boolean).join(\"\")}</div>`:\"\";return htmlString;"
    },
    {
      "$key": "6qa1si1sp1v",
      "key": "studentSelectionStatus",
