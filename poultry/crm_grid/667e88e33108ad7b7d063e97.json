        {
          "id": "batchIndex.mortality",
          "title": "Weekly Mortality",
          "type": "inner_form",
          "meta": {
            "defaultOpen": true,
            "showCopyToClipboard": false
          },
          "span": 24,
          "$key": "viprh55shf",
          "validate": "let motality = (Object.values(this.batchIndex?.mortality || {}).reduce((a,v) => a + v, 0) + (this.batchIndex?.noOfSoldBird || 0) + (this.batchInfo?.noStuntedBird || 0)); if(motality > (this.batchInfo?.nOOfDocPlaced || 0)){ return 'Invalid mortality count, you have entered ' + (motality - (this.batchInfo?.nOOfDocPlaced || 0)) + ' extra bird count'; } if(motality < (this.batchInfo?.nOOfDocPlaced || 0)){ return 'Invalid mortality count, you have missed ' + ((this.batchInfo?.nOOfDocPlaced || 0) - motality) + ' bird count'; } return motality === (this.batchInfo?.nOOfDocPlaced || 0) ? '' : 'Mortality count invalid';"
        }
      ]
    },
