      "key": "All Batch Info",
      "type": "text",
      "valueCondition": "return `<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#333;\"><div style=\"display:flex;flex-wrap:wrap;\"><div style=\"flex:1;min-width:300px;padding:5px;\"><div style=\"color:#87c66b;font-weight:600;margin-bottom:6px;\">Batch Info</div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Batch Placement</span><span>${new Date(this.batchInfo.batchPlacement).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</span></div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Number of DOC Placed</span><span>${this.batchInfo.nOOfDocPlaced}</span></div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Number of Feeder</span><span>${this.batchInfo.nOOfFeeder}</span></div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Number of Feeder / 100 Bird</span><span>${this.batchInfo.nOOfFeederBird}</span></div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Number of Drinker</span><span>${this.batchInfo.nOOfDrinker}</span></div><div style=\"display:flex;justify-content:space-between;\"><span>Number of Drinker / 100 Bird</span><span>${this.batchInfo.nOOfDrinkerBird}</span></div></div><div style=\"flex:1;min-width:300px;padding:5px;border-left:1px solid #eee;\"><div style=\"color:#87c66b;font-weight:600;margin-bottom:6px;\">Hygiene & Practices</div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Practicing before Placement of DOC</span><span></span></div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Spraying Disinfectant</span><span>${this.batchInfo.sparyingDisinfectant}</span></div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>White Wash</span><span>${this.batchInfo.whiteWash}</span></div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Wiping of Floor</span><span>${this.batchInfo.wipingOfFloor}</span></div><div style=\"display:flex;justify-content:space-between;\"><span>Fumigation</span><span>${this.batchInfo.fumigation}</span></div></div></div><div style=\"padding:5px;border-top:1px solid #eee;margin-top:10px;\"><div style=\"color:#87c66b;font-weight:600;margin-bottom:6px;\">Input Cost</div><div style=\"display:flex;justify-content:space-between;margin-bottom:4px;\"><span>Litter</span><span>₹${this.batchInfo.litter}</span></div><div style=\"display:flex;justify-content:space-between;\"><span>DOC</span><span>₹${this.batchInfo.doc}</span></div></div></div>`;",
